<?xml version="1.0" encoding="utf-8"?>
<!-- The music card's scrubber: like progress_bar, but dark on the focused (light) row. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <selector>
            <item android:state_focused="true">
                <shape><solid android:color="#33000000" /><corners android:radius="2dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="#24FFFFFF" /><corners android:radius="2dp" /></shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <selector>
                <item android:state_focused="true">
                    <shape><solid android:color="#FF111113" /><corners android:radius="2dp" /></shape>
                </item>
                <item>
                    <shape><solid android:color="#FFD8D8DC" /><corners android:radius="2dp" /></shape>
                </item>
            </selector>
        </clip>
    </item>
</layer-list>
