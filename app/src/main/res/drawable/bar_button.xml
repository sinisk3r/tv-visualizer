<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFF4F4F5" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#EB2C2C30" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
</selector>
