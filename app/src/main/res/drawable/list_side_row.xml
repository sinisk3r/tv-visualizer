<?xml version="1.0" encoding="utf-8"?>
<!-- Find's list column: focused like a card row; the list shown on the right is outlined (activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFF4F4F5" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="6dp" /></shape>
    </item>
</selector>
