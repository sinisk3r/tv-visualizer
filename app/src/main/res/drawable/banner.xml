<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV banner: the DJ logo centred on its charcoal. No text: the launcher shows the name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp" android:drawable="@drawable/ic_bg" />
    <item android:width="180dp" android:height="180dp" android:gravity="center">
        <bitmap android:src="@drawable/logo_dj" android:filter="true" android:gravity="fill" />
    </item>
</layer-list>
