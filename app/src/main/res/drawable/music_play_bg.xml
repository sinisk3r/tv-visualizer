<?xml version="1.0" encoding="utf-8"?>
<!-- The music card's larger play/pause button: a faint disc, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFF4F4F5" /></shape>
    </item>
    <item><shape android:shape="oval"><solid android:color="#1FFFFFFF" /></shape></item>
</selector>
