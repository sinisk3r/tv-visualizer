<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFF4F4F5" /><corners android:radius="11dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#29FFFFFF" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#12FFFFFF" /><corners android:radius="11dp" /></shape>
    </item>
</selector>
